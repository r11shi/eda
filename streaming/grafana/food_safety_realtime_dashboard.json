    {
      "id": 8,
      "type": "timeseries",
      "title": "Inspections per minute (rate from 10-second windows) by result",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 2,
          "queryType": "timeseries",
          "rawSql": "SELECT window_start AS time, result_group, sum(inspections) * 6 AS inspections_per_minute FROM food.window_agg FINAL WHERE $__timeFilter(window_start) GROUP BY time, result_group ORDER BY time",
          "refId": "A",
          "pluginVersion": "4.23.3"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 70
          }
        },
