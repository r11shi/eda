    {
      "id": 11,
      "type": "table",
      "title": "Area alerts: ZIP codes with at least 5 inspections and a fail rate of 40% or more (about twice the average)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "table",
          "rawSql": "SELECT zip AS ZIP, count() AS inspections, sum(is_fail) AS fails, round(100 * sum(is_fail) / count(), 1) AS fail_rate_pct, if(count() >= 5 AND 100 * sum(is_fail) / count() >= 40, 'ALERT', 'ok') AS status FROM food.inspection_events WHERE $__timeFilter(ingest_ts) GROUP BY zip HAVING count() >= 5 ORDER BY fail_rate_pct DESC LIMIT 12",
          "refId": "A",
          "pluginVersion": "4.23.3"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ALERT": {
                        "color": "red",
                        "text": "ALERT"
                      },
                      "ok": {
                        "color": "green",
                        "text": "ok"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Pipeline health: events, rejected events and end-to-end latency",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 14,
        "y": 15,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "table",
          "rawSql": "SELECT 'valid events' AS metric, toString(count()) AS value FROM food.inspection_events WHERE $__timeFilter(ingest_ts) UNION ALL SELECT 'rejected events (validation rules)', toString(count()) FROM food.invalid_events WHERE $__timeFilter(ingest_ts) UNION ALL SELECT 'avg latency emit -> ClickHouse (ms)', toString(round(avg(dateDiff('millisecond', emitted_at, written_at)))) FROM food.inspection_events WHERE $__timeFilter(ingest_ts) UNION ALL SELECT 'p95 latency (ms)', toString(round(quantile(0.95)(dateDiff('millisecond', emitted_at, written_at)))) FROM food.inspection_events WHERE $__timeFilter(ingest_ts)",
          "refId": "A",
          "pluginVersion": "4.23.3"
        }
      ]
    }
