$ psql -d foodsafety -f sql/04_validation.sql
SELECT 'fact rows whose date/facility/type/result/location key is missing in its dimension' AS check_name, count(*)::bigint AS value
FROM dw.fact_inspection f
WHERE NOT EXISTS (SELECT 1 FROM dw.dim_date d            WHERE d.date_key = f.date_key)
   OR NOT EXISTS (SELECT 1 FROM dw.dim_facility d        WHERE d.facility_key = f.facility_key)
   OR NOT EXISTS (SELECT 1 FROM dw.dim_inspection_type d WHERE d.inspection_type_key = f.inspection_type_key)
   OR NOT EXISTS (SELECT 1 FROM dw.dim_result d          WHERE d.result_key = f.result_key)
   OR NOT EXISTS (SELECT 1 FROM dw.dim_location d        WHERE d.location_key = f.location_key)
UNION ALL SELECT 'duplicate inspection ids in the fact table', count(*) - count(DISTINCT inspection_id) FROM dw.fact_inspection
UNION ALL SELECT 'cleaned completed rows in staging that did not reach the fact table', count(*) FROM staging.inspection_stg s
        WHERE s.reject_reason IS NULL AND s.is_completed AND NOT EXISTS (SELECT 1 FROM dw.fact_inspection f WHERE f.inspection_id = s.inspection_id)
UNION ALL SELECT 'total violations: staging minus fact',
        (SELECT coalesce(sum(violation_count), 0) FROM staging.inspection_stg WHERE reject_reason IS NULL AND is_completed)::bigint
      - (SELECT coalesce(sum(violation_count), 0) FROM dw.fact_inspection)::bigint
UNION ALL SELECT 'inspections: yearly summary fact minus detail fact',
        (SELECT coalesce(sum(inspection_count), 0) FROM dw.fact_facility_annual_inspection_performance)::bigint - (SELECT count(*) FROM dw.fact_inspection);
                                     check_name                                     | value 
